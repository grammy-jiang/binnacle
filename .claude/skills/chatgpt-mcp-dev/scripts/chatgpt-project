#!/usr/bin/env python3
"""Manage ChatGPT Projects from the terminal: list them, show one, set its
instructions.

A Project is a "snorlax" gizmo in ChatGPT's backend. Reads go through
/backend-api/gizmos/...; the update is PATCH /backend-api/projects/<id>
with exactly {name, emoji, theme, instructions} (measured 2026-09-07:
other fields are rejected, and name/emoji/theme are required even when
unchanged, so they are copied from the current project). Reuses the
browser's logged-in session like chatgpt-refresh; nothing is written to
disk.

    chatgpt-project list
    chatgpt-project show "Raspberry Pi 5"
    chatgpt-project get-instructions "Raspberry Pi 5"     # print current text
    chatgpt-project set-instructions "Raspberry Pi 5" --file rules.md
    chatgpt-project set-instructions "Raspberry Pi 5" --text "..."
    [--browser chromium|chrome|auto]

Name matching is case-insensitive: exact first, then a unique substring.
set-instructions reads the text back and exits non-zero on a mismatch.
"""

import argparse
import json
from pathlib import Path

import chatgpt_session as cs


def _walk(node):
    if isinstance(node, dict):
        yield node
        for v in node.values():
            yield from _walk(v)
    elif isinstance(node, list):
        for v in node:
            yield from _walk(v)


def projects(session: "cs.Session") -> list[dict]:
    status, data = session.call(
        "/backend-api/gizmos/snorlax/sidebar?owned_only=true&conversations_per_gizmo=1&limit=50"
    )
    if status != 200:
        cs.fail(f"could not list projects (HTTP {status}): {data.get('error', '')}")
    seen: dict[str, dict] = {}
    for node in _walk(data):
        if node.get("gizmo_type") == "snorlax" and "id" in node and "display" in node:
            seen[node["id"]] = node
    return list(seen.values())


def get_project(session: "cs.Session", gizmo_id: str) -> dict:
    status, data = session.call(f"/backend-api/gizmos/{gizmo_id}")
    if status != 200:
        cs.fail(f"could not read project {gizmo_id} (HTTP {status})")
    return data.get("gizmo", data)


def resolve(query: str, found: list[dict]) -> dict:
    q = query.casefold()
    exact = [p for p in found if (p["display"].get("name") or "").casefold() == q]
    hits = exact or [
        p for p in found if q in (p["display"].get("name") or "").casefold()
    ]
    if not hits:
        names = ", ".join(sorted(repr(p["display"].get("name")) for p in found))
        cs.fail(f"no project matches {query!r}; you have: {names}")
    if len(hits) > 1:
        names = ", ".join(repr(p["display"].get("name")) for p in hits)
        cs.fail(f"{query!r} matches several projects: {names}")
    return hits[0]


def set_instructions(session: "cs.Session", gizmo_id: str, text: str) -> None:
    cur = get_project(session, gizmo_id)
    disp = cur["display"]
    payload = {
        "name": disp["name"],
        "emoji": disp.get("emoji"),
        "theme": disp.get("theme"),
        "instructions": text,
    }
    status, data = session.call(
        f"/backend-api/projects/{gizmo_id}", method="PATCH", payload=payload
    )
    if status != 200:
        cs.fail(f"update failed (HTTP {status}): {json.dumps(data)[:300]}")
    back = (get_project(session, gizmo_id).get("instructions") or "").strip()
    if back != text.strip():
        cs.fail("update returned 200 but the read-back text differs")


def main() -> None:
    p = argparse.ArgumentParser(
        prog="chatgpt-project", description="Manage ChatGPT Projects."
    )
    p.add_argument("--browser", choices=["auto", "chromium", "chrome"], default="auto")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="list your projects")
    sp = sub.add_parser("show", help="show one project's metadata")
    sp.add_argument("name")
    gp = sub.add_parser("get-instructions", help="print a project's instructions")
    gp.add_argument("name")
    st = sub.add_parser("set-instructions", help="replace a project's instructions")
    st.add_argument("name")
    src = st.add_mutually_exclusive_group(required=True)
    src.add_argument("--file", type=Path, help="read the text from this file")
    src.add_argument("--text", help="use this literal text")
    args = p.parse_args()

    cs.set_prog("chatgpt-project")
    session = cs.Session(args.browser)
    found = projects(session)

    if args.cmd == "list":
        width = max((len(p_["display"].get("name") or "") for p_ in found), default=0)
        for p_ in sorted(
            found, key=lambda x: (x["display"].get("name") or "").casefold()
        ):
            n = len((p_.get("instructions") or "").strip())
            print(
                f"{p_['display'].get('name'):{width}}  {p_['id']}  instructions: {n} chars"
            )
        return

    proj = resolve(args.name, found)
    if args.cmd == "show":
        full = get_project(session, proj["id"])
        keep = {
            k: full.get(k)
            for k in ("id", "display", "model", "memory_enabled", "updated_at")
        }
        keep["instructions_chars"] = len((full.get("instructions") or "").strip())
        print(json.dumps(keep, indent=2, ensure_ascii=False))
    elif args.cmd == "get-instructions":
        print(get_project(session, proj["id"]).get("instructions") or "")
    elif args.cmd == "set-instructions":
        text = args.file.read_text(encoding="utf-8") if args.file else args.text
        set_instructions(session, proj["id"], text)
        print(
            f"Updated instructions of {proj['display'].get('name')!r} ({len(text.strip())} chars, verified by read-back)."
        )


if __name__ == "__main__":
    main()
