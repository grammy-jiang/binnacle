#!/usr/bin/env python3
"""Send a message in a ChatGPT chat from the terminal and print the reply.

The browser half of an end-to-end MCP test: post a prompt into an existing
conversation (or a new one), wait for the assistant to finish, and print its
final message. Pair it with the server journal to prove a tool call went
ChatGPT -> tunnel -> server and back.

Since 2026-09-27 this is a thin wrapper around the chatgpt-web-operations
skill, the one maintained ChatGPT client on this host (~/.claude/skills/
chatgpt-web-operations; override with CHATGPT_WEB_OPS_DIR). It runs the
skill's send_prompt.py once, in its own waiting mode: the skill posts the
message in its browser window, waits for the reply over HTTP with its own
403/429 handling, and writes a JSON document, which this script turns into
its own outputs. This script never reads ChatGPT over HTTP itself. Before,
it drove its own Playwright page and broke whenever ChatGPT changed a page
the skill had already adapted to (2026-09-26: the composer lost
#prompt-textarea).

    chatgpt-send --chat <id|url> "message"          # existing conversation
    chatgpt-send --new "message"                    # new chat; prints its URL
    chatgpt-send --project g-p-<id> "message"       # new chat inside a Project
    [--timeout 180] [--browser chrome|chromium|auto] [--json] [--url-file PATH]
    [--timing-file PATH] [--visible]

How the options map to the skill, and what differs from the script before
2026-09-27:

- --chat, --project, --browser, --visible and --timeout are passed on;
  --new passes neither --chat nor --project. --timeout is the skill's reply
  wait, whole. The skill polls the conversation every 60 s, growing to
  150 s, and returns on the second poll that sees the same finished reply,
  so a reply is printed one to two poll intervals after it ends, and the
  wait can overrun --timeout by one interval. This script stops the send
  after TIMEOUT + 300 s at the latest. A caller that kills this script ends
  the skill's process too (PR_SET_PDEATHSIG), so no browser outlives it.
- For --chat the skill opens its HTTP session before it posts; the new-chat
  fast path it gets here (RP_NEWCHAT_FAST=1) skips that. Under read-path
  throttling the session can take the skill's authentication backoff (up to
  about 5 min) before a --chat post.
- The skill records the message's POST body (--record-send-body, with
  RP_RECORD_STREAM=0 so it does not wait for the reply stream). The file
  appears at the moment of the POST, which is the evidence of submission:
  --timing-file gets {"status": "running", "sent_at_epoch_s": <POST time>}
  then, and for --chat the --url-file too. For a new chat the URL is known,
  and --url-file written, when the skill returns.
- On success --timing-file gets status "complete" with sent_at_epoch_s,
  observed_at_epoch_s (when the skill returned), settled_at_epoch_s (the
  same, settle_time_source "send_prompt_poll") and wall_s, which therefore
  includes the skill's poll delay. A reply timeout after the POST gives
  "timeout"; any other failure after the POST gives "submitted_unconfirmed",
  so a caller never retries a turn that may exist.
- confirmations_clicked is always 0 and buttons_seen is empty: the skill
  does not approve connector confirmation cards (this connector's tools
  showed none in 2026).

Exit 0 with the reply on stdout; non-zero with a reason otherwise.
"""

from __future__ import annotations

import argparse
import contextlib
import ctypes
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable
from datetime import datetime
from pathlib import Path
from typing import Any, NoReturn

SKILL_DIR = Path(
    os.environ.get("CHATGPT_WEB_OPS_DIR", "~/.claude/skills/chatgpt-web-operations")
).expanduser()
SKILL_PYTHON = SKILL_DIR / ".venv" / "bin" / "python"
SEND_PROMPT = SKILL_DIR / "scripts" / "send_prompt.py"

OVERRUN_S = 300.0  # the send is stopped after TIMEOUT + this at the latest
POLL_S = 0.5  # how often the skill's process and its POST record are checked
STOP_GRACE_S = 10.0  # SIGTERM, then SIGKILL after this

UUID = r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"


def fail(msg: str) -> NoReturn:
    print(f"chatgpt-send: {msg}", file=sys.stderr)
    raise SystemExit(1)


def _conversation_id(url: str) -> str | None:
    match = re.search(rf"/c/({UUID})", url, re.IGNORECASE)
    return match.group(1).lower() if match else None


def chat_arg(chat: str) -> str:
    """The bare conversation id from an id or a (project) chat URL."""
    cid = _conversation_id(chat)
    if cid is None and re.fullmatch(UUID, chat.strip(), re.IGNORECASE):
        cid = chat.strip().lower()
    if cid is None:
        fail(f"not a conversation id or URL: {chat!r}")
    return cid


def project_arg(project: str) -> str:
    match = re.search(r"(g-p-[0-9a-f]{32})", project)
    if not match:
        fail(f"not a project id: {project!r} (use `chatgpt-project list`)")
    return match.group(1)


def _record_chat_url(path: str | None, url: str) -> None:
    """Persist the conversation URL so a caller can clean up the exact chat."""
    if path is None or _conversation_id(url) is None:
        return
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(url + "\n", encoding="utf-8")


def _record_timing(path: str | None, payload: dict) -> None:
    """Atomically persist timing evidence, including failure paths."""
    if path is None:
        return
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(target.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, target)


def send_argv(
    prompt_file: Path,
    json_out: Path,
    body_out: Path,
    *,
    chat: str | None,
    project: str | None,
    browser: str,
    visible: bool,
    timeout_s: float,
) -> list[str]:
    """The skill's send_prompt.py command line: one post, then its reply wait."""
    argv = [
        str(SKILL_PYTHON),
        str(SEND_PROMPT),
        str(prompt_file),
        "--json",
        str(json_out),
        "--record-send-body",
        str(body_out),
        "--browser",
        browser,
        "--timeout",
        f"{timeout_s:g}",
    ]
    if chat:
        argv += ["--chat", chat]
    if project:
        argv += ["--project", project]
    if visible:
        argv.append("--visible")
    return argv


def _die_with_parent() -> None:
    """Run in the child before exec: SIGTERM it when this process dies."""
    with contextlib.suppress(OSError, AttributeError):
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGTERM)  # PDEATHSIG


def _epoch_of_iso(value: object) -> float | None:
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _last_line(text: str) -> str:
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    return lines[-1] if lines else ""


def run(
    chat: str | None,
    message: str,
    browser: str,
    timeout_s: float,
    visible: bool = False,
    project: str | None = None,
    url_file: str | None = None,
    timing_file: str | None = None,
    *,
    popen: Callable[..., Any] = subprocess.Popen,
    clock: Callable[[], float] = time.monotonic,
    sleep: Callable[[float], None] = time.sleep,
) -> dict:
    """Run the skill's send_prompt.py once and turn its result into ours."""
    chat_url = f"https://chatgpt.com/c/{chat}" if chat else None
    deadline = clock() + timeout_s + OVERRUN_S
    with tempfile.TemporaryDirectory(prefix="chatgpt-send-") as tmp:
        work = Path(tmp)
        prompt_file = work / "prompt.txt"
        prompt_file.write_text(message, encoding="utf-8")
        json_out, body_out, log = (
            work / "send.json",
            work / "send-body.json",
            work / "send.log",
        )
        argv = send_argv(
            prompt_file,
            json_out,
            body_out,
            chat=chat,
            project=project,
            browser=browser,
            visible=visible,
            timeout_s=timeout_s,
        )
        env = dict(os.environ)
        env.setdefault("RP_NEWCHAT_FAST", "1")  # a new chat posts before any read
        env.setdefault("RP_RECORD_STREAM", "0")  # the reply is read over HTTP
        sent_at: float | None = None
        stopped = False
        with log.open("w", encoding="utf-8") as out:
            try:
                proc = popen(
                    argv,
                    stdout=out,
                    stderr=subprocess.STDOUT,
                    env=env,
                    preexec_fn=_die_with_parent,
                )
            except OSError as exc:
                fail(f"could not start the skill's send_prompt.py: {exc}")
            while proc.poll() is None:
                if sent_at is None and body_out.exists():
                    sent_at = body_out.stat().st_mtime
                    _record_timing(
                        timing_file, {"status": "running", "sent_at_epoch_s": sent_at}
                    )
                    if chat_url:
                        _record_chat_url(url_file, chat_url)
                if clock() >= deadline:
                    stopped = True
                    proc.terminate()
                    try:
                        proc.wait(timeout=STOP_GRACE_S)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                        proc.wait()
                    break
                sleep(POLL_S)
        observed_at = time.time()
        if sent_at is None and body_out.exists():  # posted just before it ended
            sent_at = body_out.stat().st_mtime
        doc: Any = None
        if json_out.exists():
            with contextlib.suppress(ValueError):
                doc = json.loads(json_out.read_text(encoding="utf-8"))
        output = log.read_text(encoding="utf-8", errors="replace")

    rc = proc.returncode
    done = (
        not stopped
        and rc == 0
        and isinstance(doc, dict)
        and isinstance(doc.get("reply"), str)
        and bool(doc.get("conversation_id"))
        and doc.get("resolved", True) is True
    )
    if not done:
        if isinstance(doc, dict) and doc.get("url"):
            _record_chat_url(url_file, str(doc["url"]))
        if stopped:
            reason = f"stopped after {timeout_s + OVERRUN_S:g} s"
        else:
            reason = _last_line(output).removeprefix("send failed: ") or f"exit {rc}"
        if sent_at is not None:
            timed_out = stopped or "did not finish" in reason
            payload: dict[str, Any] = {
                "status": "timeout" if timed_out else "submitted_unconfirmed",
                "sent_at_epoch_s": sent_at,
            }
            if timed_out:
                payload["observed_at_epoch_s"] = observed_at
                payload["wall_s"] = round(max(0.0, observed_at - sent_at), 3)
            _record_timing(timing_file, payload)
        posted = "posted" if sent_at is not None else "not posted"
        fail(f"send failed ({posted}): {reason[:200]}")

    url = str(doc.get("url") or f"https://chatgpt.com/c/{doc['conversation_id']}")
    _record_chat_url(url_file, url)
    sent_source = "post_record"
    if sent_at is None:  # no POST record: the skill's own start time (seconds)
        sent_at = _epoch_of_iso(doc.get("sent_at")) or observed_at
        sent_source = "send_prompt_start"
    timing = {
        "sent_at_epoch_s": sent_at,
        "sent_at_source": sent_source,
        "settled_at_epoch_s": observed_at,
        "observed_at_epoch_s": observed_at,
        "settle_time_source": "send_prompt_poll",
        "wall_s": round(max(0.0, observed_at - sent_at), 3),
    }
    _record_timing(timing_file, {"status": "complete", **timing})
    return {
        "url": url,
        "conversation_id": str(doc["conversation_id"]),
        "confirmations_clicked": 0,
        "buttons_seen": [],
        "reply": doc["reply"],
        **timing,
    }


def main() -> None:
    ap = argparse.ArgumentParser(
        prog="chatgpt-send", description=__doc__.split("\n\n")[0]
    )
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--chat", help="conversation id or https://chatgpt.com/c/<id> URL")
    g.add_argument("--new", action="store_true", help="start a new conversation")
    g.add_argument(
        "--project",
        help="start a new conversation inside this Project (g-p-... id; see chatgpt-project list)",
    )
    ap.add_argument("message")
    ap.add_argument(
        "--timeout",
        type=float,
        default=180.0,
        help="seconds the skill waits for the reply (the send stops after TIMEOUT + 300 s)",
    )
    ap.add_argument("--browser", choices=["auto", "chromium", "chrome"], default="auto")
    ap.add_argument(
        "--json", action="store_true", help="print {url, confirmations_clicked, reply}"
    )
    ap.add_argument(
        "--url-file",
        help="write the conversation URL once it is known (for exact cleanup after a timeout)",
    )
    ap.add_argument(
        "--timing-file",
        help="atomically write send/settle timing evidence, including failure paths",
    )
    ap.add_argument(
        "--visible",
        action="store_true",
        help="show the browser on screen while posting",
    )
    args = ap.parse_args()
    chat = chat_arg(args.chat) if args.chat else None
    project = project_arg(args.project) if args.project else None
    if not (SKILL_PYTHON.exists() and SEND_PROMPT.exists()):
        fail(
            f"the chatgpt-web-operations skill is missing at {SKILL_DIR} "
            f"(or its venv: run {SKILL_DIR / 'bootstrap.sh'})"
        )

    result = run(
        chat,
        args.message,
        args.browser,
        args.timeout,
        args.visible,
        project,
        args.url_file,
        args.timing_file,
    )
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(
            f"[{result['url']}] confirmations clicked: {result['confirmations_clicked']}"
        )
        print(result["reply"])


if __name__ == "__main__":
    main()
