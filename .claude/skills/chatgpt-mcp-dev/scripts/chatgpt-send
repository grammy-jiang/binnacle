#!/usr/bin/env python3
"""Send a message in a ChatGPT chat from the terminal and print the reply.

The browser half of an end-to-end MCP test: post a prompt into an existing
conversation (or a new one), wait for the assistant to finish, and print its
final message. Pair it with the server journal to prove a tool call went
ChatGPT -> tunnel -> server and back.

Since 2026-09-27 the send goes through the chatgpt-web-operations skill, the
one maintained ChatGPT client on this host (~/.claude/skills/
chatgpt-web-operations, override with CHATGPT_WEB_OPS_DIR): its send_prompt.py
posts the message (--no-wait) and resolves the conversation id, and the reply
is then read over HTTP with the skill's wait_for_reply. This script keeps only
the command line, the output shapes and the evidence files. Before, it drove
its own Playwright page and broke on every ChatGPT change the skill had
already absorbed (2026-09-26: the composer lost #prompt-textarea).

    chatgpt-send --chat <id|url> "message"          # existing conversation
    chatgpt-send --new "message"                    # new chat; prints its URL
    chatgpt-send --project g-p-<id> "message"       # new chat inside a Project
    [--timeout 180] [--browser chrome|chromium|auto] [--json] [--url-file PATH]
    [--timing-file PATH] [--visible]

Differences from the script before 2026-09-27:

- --timeout bounds the whole command: posting and the reply wait end within
  TIMEOUT + 20 s, because callers such as scripts/chat_scheduling_chat.py
  kill the process at TIMEOUT + 30 s. Before, it bounded only the reply wait.
- --url-file is written right after the post, once the real conversation id
  is known (the skill resolves a new chat's provisional id before it
  returns), not while a page was still open.
- --timing-file: "running" is written right after the post. If the post fails
  after the skill recorded the POST body, "submitted_unconfirmed" is written,
  so a caller never retries a turn that may have been submitted.
  settled_at_epoch_s is the final assistant message's own create_time (the
  2026-09-26 timing lesson); observed_at_epoch_s is when this script saw it.
- confirmations_clicked is always 0 and buttons_seen is empty: the reply is
  read over HTTP, not from a page, so a connector confirmation card would not
  be approved and the command would time out. ChatGPT has not shown such
  cards for this connector's tools in 2026.
- A reply counts as final when the newest node is a finished visible assistant
  message on two consecutive polls (10 s apart at first, growing to 30 s), so
  a short reply is printed about 15-25 s after it ends, not 2 s.

Exit 0 with the reply on stdout; non-zero with a reason otherwise.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable
from pathlib import Path
from typing import Any, NoReturn

SKILL_DIR = Path(
    os.environ.get("CHATGPT_WEB_OPS_DIR", "~/.claude/skills/chatgpt-web-operations")
).expanduser()
SKILL_SCRIPTS = SKILL_DIR / "scripts"
SKILL_PYTHON = SKILL_DIR / ".venv" / "bin" / "python"
REEXEC_FLAG = "CHATGPT_SEND_REEXEC"

DEADLINE_ALLOWANCE_S = 20.0  # the whole command ends within TIMEOUT + this
POST_BUDGET_S = 150.0  # browser start, page, composer, post and id resolution
POLL_INTERVAL_S = 10.0  # first poll gap for the reply (grows to POLL_MAX_S)
POLL_MAX_S = 30.0
CONFIRM_POLL_S = 5.0  # gap of the second, confirming poll of a final reply

UUID = r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"


def fail(msg: str) -> NoReturn:
    print(f"chatgpt-send: {msg}", file=sys.stderr)
    raise SystemExit(1)


def _reexec_in_skill_venv() -> None:
    """Run under the skill's own interpreter, which has its dependencies."""
    venv = SKILL_DIR / ".venv"
    if os.environ.get(REEXEC_FLAG) or Path(sys.prefix).resolve() == venv.resolve():
        return
    if not SKILL_PYTHON.exists():
        fail(
            f"the chatgpt-web-operations skill has no venv at {SKILL_PYTHON}; "
            f"run {SKILL_DIR / 'bootstrap.sh'}"
        )
    env = dict(os.environ, **{REEXEC_FLAG: "1"})
    # Intentional process replacement with the skill's interpreter; no shell.
    os.execve(  # nosec B606
        str(SKILL_PYTHON),
        [str(SKILL_PYTHON), os.path.abspath(__file__), *sys.argv[1:]],
        env,
    )


def _conversation_id(url: str) -> str | None:
    match = re.search(rf"/c/({UUID})", url, re.IGNORECASE)
    return match.group(1).lower() if match else None


def chat_arg(chat: str) -> str:
    """The bare conversation id from an id or a (project) chat URL."""
    cid = _conversation_id(chat)
    if cid is None and re.fullmatch(UUID, chat.strip(), re.IGNORECASE):
        cid = chat.strip().lower()
    if cid is None:
        fail(f"not a conversation id or URL: {chat!r}")
    return cid


def project_arg(project: str) -> str:
    match = re.search(r"(g-p-[0-9a-f]{32})", project)
    if not match:
        fail(f"not a project id: {project!r} (use `chatgpt-project list`)")
    return match.group(1)


def _final_from_conversation(data: object) -> tuple[bool, str]:
    """Return backend final-completion state and final assistant text."""
    if not isinstance(data, dict):
        return False, ""
    mapping = data.get("mapping")
    if not isinstance(mapping, dict):
        return False, ""
    current = mapping.get(data.get("current_node"))
    if not isinstance(current, dict):
        return False, ""
    message = current.get("message")
    if not isinstance(message, dict):
        return False, ""
    author = message.get("author")
    if not isinstance(author, dict) or author.get("role") != "assistant":
        return False, ""
    metadata = message.get("metadata")
    metadata = metadata if isinstance(metadata, dict) else {}
    complete = bool(metadata.get("is_complete")) or (
        message.get("status") == "finished_successfully"
        and message.get("end_turn") is True
    )
    content = message.get("content")
    content = content if isinstance(content, dict) else {}
    parts = content.get("parts")
    text = "\n".join(part for part in (parts or []) if isinstance(part, str))
    return complete, text


def _final_create_time(data: object) -> float | None:
    """create_time of the current node when it is a complete assistant reply."""
    complete, _ = _final_from_conversation(data)
    if not complete or not isinstance(data, dict):
        return None
    message = data["mapping"][data["current_node"]]["message"]
    value = message.get("create_time")
    return float(value) if isinstance(value, (int, float)) else None


def _record_chat_url(path: str | None, url: str) -> None:
    """Persist the conversation URL so a caller can clean up the exact chat."""
    if path is None or _conversation_id(url) is None:
        return
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(url + "\n", encoding="utf-8")


def _record_timing(path: str | None, payload: dict) -> None:
    """Atomically persist timing evidence, including failure paths."""
    if path is None:
        return
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(target.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, target)


def send_argv(
    prompt_file: Path,
    json_out: Path,
    body_out: Path,
    *,
    chat: str | None,
    project: str | None,
    browser: str,
    visible: bool,
) -> list[str]:
    """The skill's send_prompt.py command line for one post without waiting."""
    argv = [
        str(SKILL_PYTHON),
        str(SKILL_SCRIPTS / "send_prompt.py"),
        str(prompt_file),
        "--no-wait",
        "--json",
        str(json_out),
        "--record-send-body",
        str(body_out),
        "--browser",
        browser,
    ]
    if chat:
        argv += ["--chat", chat]
    if project:
        argv += ["--project", project]
    if visible:
        argv.append("--visible")
    return argv


class _Recorder:
    """Session proxy that keeps the last conversation wait_for_reply read."""

    def __init__(self, session: Any) -> None:
        self._session = session
        self.last: object = None

    def get_conversation(self, chat: str) -> dict:
        self.last = self._session.get_conversation(chat)
        return self.last  # type: ignore[return-value]


def run(
    chat: str | None,
    message: str,
    browser: str,
    timeout_s: float,
    visible: bool = False,
    project: str | None = None,
    url_file: str | None = None,
    timing_file: str | None = None,
    *,
    cc: Any,
    session_factory: Callable[[str], Any],
    runner: Callable[..., Any] = subprocess.run,
    clock: Callable[[], float] = time.monotonic,
) -> dict:
    """Post through the skill, wait for the reply over HTTP, return the result."""
    deadline = clock() + timeout_s + DEADLINE_ALLOWANCE_S
    try:
        session = session_factory(browser)
    except Exception as exc:  # noqa: BLE001 - any auth failure; nothing was posted, a caller may retry
        fail(f"could not open a ChatGPT session: {str(exc)[:200]}")
    min_user_turns = 1
    if chat:
        try:
            min_user_turns = cc.user_turns(session.get_conversation(chat)) + 1
        except Exception as exc:  # noqa: BLE001 - the post still works; the guard is weaker
            print(
                f"chatgpt-send: could not count the chat's turns ({str(exc)[:120]}); "
                "an earlier reply could be taken for this one",
                file=sys.stderr,
            )

    with tempfile.TemporaryDirectory(prefix="chatgpt-send-") as tmp:
        work = Path(tmp)
        prompt_file = work / "prompt.txt"
        prompt_file.write_text(message, encoding="utf-8")
        json_out, body_out = work / "send.json", work / "send-body.json"
        argv = send_argv(
            prompt_file,
            json_out,
            body_out,
            chat=chat,
            project=project,
            browser=browser,
            visible=visible,
        )
        env = dict(os.environ)
        env.setdefault("RP_NEWCHAT_FAST", "1")  # post first; no lock or listing
        env.setdefault("RP_RECORD_STREAM", "0")  # the answer is read over HTTP
        budget = max(1.0, min(POST_BUDGET_S, deadline - clock() - 5.0))
        try:
            proc = runner(argv, capture_output=True, text=True, timeout=budget, env=env)
            rc, detail = proc.returncode, (proc.stdout or "") + (proc.stderr or "")
        except subprocess.TimeoutExpired:
            rc, detail = None, f"the post did not finish within {budget:g} s"
        except OSError as exc:
            rc, detail = None, f"could not run the skill's send_prompt.py: {exc}"
        doc = None
        if rc == 0 and json_out.exists():
            try:
                doc = json.loads(json_out.read_text(encoding="utf-8"))
            except ValueError:
                detail += "\nsend_prompt.py wrote an unreadable --json document"
        submitted_at = body_out.stat().st_mtime if body_out.exists() else None

    conversation_id = str((doc or {}).get("conversation_id") or "")
    if (
        doc is None
        or not doc.get("resolved", True)
        or cc.is_provisional(conversation_id)
    ):
        if submitted_at is not None:
            _record_timing(
                timing_file,
                {"status": "submitted_unconfirmed", "sent_at_epoch_s": submitted_at},
            )
        last = detail.strip().splitlines()[-1:] or ["no output"]
        fail(f"send failed (exit {rc}): {last[0][:200]}")

    url = str(doc.get("url") or f"https://chatgpt.com/c/{conversation_id}")
    sent_at = submitted_at if submitted_at is not None else time.time()
    sent_mono = clock()
    _record_chat_url(url_file, url)
    _record_timing(timing_file, {"status": "running", "sent_at_epoch_s": sent_at})

    recorder = _Recorder(session)
    try:
        reply = cc.wait_for_reply(
            recorder,
            conversation_id,
            timeout=max(1.0, deadline - clock()),
            interval=POLL_INTERVAL_S,
            max_interval=POLL_MAX_S,
            min_user_turns=min_user_turns,
            confirm_interval=CONFIRM_POLL_S,
        )
    except (OSError, cc.TransportError) as exc:  # TimeoutError is an OSError
        _, last_text = _final_from_conversation(recorder.last)
        _record_timing(
            timing_file,
            {
                "status": "timeout",
                "sent_at_epoch_s": sent_at,
                "observed_at_epoch_s": time.time(),
                "wall_s": round(clock() - sent_mono, 3),
                "last_text": last_text,
            },
        )
        fail(f"no complete reply at {url}: {str(exc)[:200]}")

    observed_at = time.time()
    settled_at = _final_create_time(recorder.last)
    source = "conversation_final_assistant_timestamp"
    if settled_at is None:
        settled_at, source = observed_at, "observed"
    wall_s = round(max(0.0, settled_at - sent_at), 3)
    _record_timing(
        timing_file,
        {
            "status": "complete",
            "sent_at_epoch_s": sent_at,
            "settled_at_epoch_s": settled_at,
            "observed_at_epoch_s": observed_at,
            "settle_time_source": source,
            "wall_s": wall_s,
        },
    )
    return {
        "url": url,
        "conversation_id": conversation_id,
        "confirmations_clicked": 0,
        "buttons_seen": [],
        "reply": reply,
        "sent_at_epoch_s": sent_at,
        "settled_at_epoch_s": settled_at,
        "observed_at_epoch_s": observed_at,
        "settle_time_source": source,
        "wall_s": wall_s,
    }


def main() -> None:
    ap = argparse.ArgumentParser(
        prog="chatgpt-send", description=__doc__.split("\n\n")[0]
    )
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--chat", help="conversation id or https://chatgpt.com/c/<id> URL")
    g.add_argument("--new", action="store_true", help="start a new conversation")
    g.add_argument(
        "--project",
        help="start a new conversation inside this Project (g-p-... id; see chatgpt-project list)",
    )
    ap.add_argument("message")
    ap.add_argument(
        "--timeout",
        type=float,
        default=180.0,
        help="seconds for the reply; the whole command ends within TIMEOUT + 20 s",
    )
    ap.add_argument("--browser", choices=["auto", "chromium", "chrome"], default="auto")
    ap.add_argument(
        "--json", action="store_true", help="print {url, confirmations_clicked, reply}"
    )
    ap.add_argument(
        "--url-file",
        help="write the conversation URL right after the post (for exact cleanup after a timeout)",
    )
    ap.add_argument(
        "--timing-file",
        help="atomically write send/settle timing evidence, including failure paths",
    )
    ap.add_argument(
        "--visible",
        action="store_true",
        help="show the browser on screen while posting",
    )
    args = ap.parse_args()
    chat = chat_arg(args.chat) if args.chat else None
    project = project_arg(args.project) if args.project else None

    _reexec_in_skill_venv()
    sys.path.insert(0, str(SKILL_SCRIPTS))
    import chatgpt_client as cc  # the skill's documented import bridge
    import chatgpt_session as skill_session

    browser = skill_session.pick_browser(args.browser)
    result = run(
        chat,
        args.message,
        browser,
        args.timeout,
        args.visible,
        project,
        args.url_file,
        args.timing_file,
        cc=cc,
        session_factory=cc.ChatGPTSession,
    )
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(
            f"[{result['url']}] confirmations clicked: {result['confirmations_clicked']}"
        )
        print(result["reply"])


if __name__ == "__main__":
    main()
