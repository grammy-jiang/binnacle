#!/usr/bin/env python3
"""Set the GNOME "Default keyring" password to empty, so it auto-unlocks.

Why: this Pi uses autologin, so no login password is entered and nothing
unlocks the keyring at boot. Chrome's cookie-encryption key lives in that
keyring, so chatgpt-refresh / chatgpt-send / chatgpt-chats fail until it is
unlocked by hand. An empty-password keyring unlocks automatically at every
boot, which removes that manual step for good.

What it does: calls the same private gnome-keyring D-Bus method that
Seahorse's "Change Password" uses (ChangeWithMasterPassword). It changes
ONLY the master password; your stored secrets are untouched. Nothing is
written to disk by this script, and your current password is read with
getpass (never stored, never echoed).

Run once, in your own terminal (it needs a TTY for the prompt):

    python3 set-empty-keyring-password

Security: an empty-password keyring stores its secrets with a key derived
from the empty string, so anyone with access to your logged-in session can
read them. On an autologin machine that is already the case, so this
matches your existing posture. It is your call.
"""

import getpass
import sys

import dbus

SS = "org.freedesktop.secrets"
ROOT = "/org/freedesktop/secrets"
COLL_IFACE = "org.freedesktop.Secret.Collection"
GUILT = "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface"


def find_collection(bus, service):
    """The 'default' alias, else the collection labelled Default keyring/login."""
    alias = service.ReadAlias("default")
    if str(alias) not in ("", "/"):
        return str(alias)
    props = dbus.Interface(bus.get_object(SS, ROOT), "org.freedesktop.DBus.Properties")
    for path in props.Get("org.freedesktop.Secret.Service", "Collections"):
        p = dbus.Interface(bus.get_object(SS, path), "org.freedesktop.DBus.Properties")
        if str(p.Get(COLL_IFACE, "Label")) in ("Default keyring", "login", "Login"):
            return str(path)
    sys.exit("could not find the Default keyring collection")


def label(bus, path):
    p = dbus.Interface(bus.get_object(SS, path), "org.freedesktop.DBus.Properties")
    return str(p.Get(COLL_IFACE, "Label"))


def main() -> None:
    bus = dbus.SessionBus()
    root = bus.get_object(SS, ROOT)
    service = dbus.Interface(root, "org.freedesktop.Secret.Service")
    _, session = service.OpenSession("plain", dbus.String("", variant_level=1))
    coll = find_collection(bus, service)
    print(f"Target keyring: {label(bus, coll)} ({coll})")

    current = getpass.getpass("Current keyring password (leave empty if none): ")

    def secret(value: str):
        return dbus.Struct(
            (
                dbus.ObjectPath(session),
                dbus.Array([], signature="y"),
                dbus.ByteArray(value.encode("utf-8")),
                dbus.String("text/plain"),
            ),
            signature="oayays",
        )

    guilt = dbus.Interface(root, GUILT)
    try:
        guilt.ChangeWithMasterPassword(coll, secret(current), secret(""))
    except dbus.DBusException as e:
        sys.exit(f"change failed: {e.get_dbus_message()} (wrong current password?)")

    # Verify: lock, then unlock. An empty-password keyring unlocks with no prompt.
    service.Lock([coll])
    _, prompt = service.Unlock([coll])
    if str(prompt) not in ("/", ""):
        dbus.Interface(
            bus.get_object(SS, str(prompt)), "org.freedesktop.Secret.Prompt"
        ).Dismiss()
        sys.exit("password changed, but a prompt is still required — not empty?")
    print("Done: the keyring has an empty password and now unlocks automatically.")
    print("It is unlocked right now, and will be at every boot.")


if __name__ == "__main__":
    main()
