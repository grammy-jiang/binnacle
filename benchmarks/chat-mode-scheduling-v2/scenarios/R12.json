{
  "benchmark_class": "macro",
  "dag": [
    {
      "access": "non_read_only",
      "arguments": {
        "background": true,
        "command": "python3 -c 'import time; time.sleep({budget_plus_margin_s})'",
        "wait_seconds": 1,
        "workdir": "{root}"
      },
      "depends_on": [],
      "id": "start_job",
      "kind": "tool",
      "tool": "run_command"
    },
    {
      "access": "read_only",
      "allow_repeats": true,
      "arguments": {
        "job_id": "{result:start_job.job_id}",
        "tail_lines": 20,
        "wait_seconds": 50
      },
      "completion_condition": "job_state=exited",
      "depends_on": [
        "start_job"
      ],
      "id": "wait_result",
      "kind": "tool",
      "tool": "job_status"
    }
  ],
  "expected_runtime_s": 630,
  "fixture": {
    "allowed_mutation_globs": [
      "{root}/**"
    ],
    "files": [],
    "jobs": [],
    "kind": "ephemeral_dir",
    "production_mutation_allowed": false,
    "root_template": "/tmp/binnacle-chat-scheduling-v2/{id}/{run_id}"
  },
  "id": "R12",
  "max_turn_runtime_s": 690,
  "metric_tags": [
    "wall_time",
    "dependency_wait",
    "budget_exhaustion",
    "continuation_prompts",
    "exclude_aggregate_performance"
  ],
  "oracle": {
    "checks": [
      {
        "params": {
          "values": [
            "BUDGET_EXHAUSTED",
            "job_id=",
            "state=running",
            "pending=dependency",
            "resume=job_status"
          ]
        },
        "type": "reply_contains_all"
      },
      {
        "params": {
          "fields": {
            "blocking_budget_exhausted": true,
            "state": "running"
          },
          "node": "wait_result"
        },
        "type": "job_status_any_call"
      }
    ],
    "terminal_state": "budget_exhaustion_handoff"
  },
  "phase1_step": null,
  "prompt_template": "Use Raspberry Pi MCP. In {root}, start this exact command with run_command background=true and wait_seconds=1: python3 -c 'import time; time.sleep({budget_plus_margin_s})'. There is no independent work. Keep checking the returned job as the true dependency. If the blocking-wait budget is exhausted while the job is still running, hand off with exactly this field layout using the actual returned job id: BUDGET_EXHAUSTED job_id=<actual-id> state=running pending=dependency resume=job_status. This budget-exhaustion handoff is intentional and is not DONE.",
  "purpose": "Exercise the intentional checkpoint handoff when a true dependency outlives the configured blocking-wait budget.",
  "runtime_budget_margin_s": 30,
  "schema_version": 1,
  "title": "Budget-exhaustion dependency handoff"
}
