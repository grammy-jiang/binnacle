[Unit]
Description=Binnacle privileged self-management broker (default disabled)
Documentation=https://github.com/grammy-jiang/binnacle/tree/master/docs/operations
Requires=binnacle-privileged.socket
After=binnacle-privileged.socket
ConditionPathExists=/etc/binnacle-privileged/broker.toml
ConditionPathExists=/var/lib/binnacle-privileged/evidence.db
ConditionPathExists=/opt/binnacle-privileged/bin/binnacle-privileged-broker

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/empty
ExecStart=/opt/binnacle-privileged/bin/binnacle-privileged-broker --config /etc/binnacle-privileged/broker.toml
Restart=on-failure
RestartSec=2s
KillMode=control-group
SendSIGKILL=yes
Delegate=no
UMask=0077
ReadWritePaths=/run/binnacle-privileged
ReadWritePaths=/var/lib/binnacle-privileged
InaccessiblePaths=/srv/binnacle-dev/repo
InaccessiblePaths=/etc/binnacle
InaccessiblePaths=/var/lib/binnacle
InaccessiblePaths=-/run/binnacle
InaccessiblePaths=/etc/binnacle-executor
InaccessiblePaths=/var/lib/binnacle-executor
InaccessiblePaths=-/run/binnacle-executor
InaccessiblePaths=/etc/binnacle-git-credential
InaccessiblePaths=/var/lib/binnacle-git-credential
InaccessiblePaths=-/run/binnacle-git-credential
InaccessiblePaths=-/run/systemd/private
InaccessiblePaths=-/run/dbus/system_bus_socket
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
