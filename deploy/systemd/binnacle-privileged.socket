[Unit]
Description=Binnacle privileged self-management broker socket (default disabled)
Documentation=https://github.com/grammy-jiang/binnacle/tree/master/docs/operations

[Socket]
ListenStream=/run/binnacle-privileged/broker.sock
Accept=no
SocketUser=root
SocketGroup=binnacle-privileged-client
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
