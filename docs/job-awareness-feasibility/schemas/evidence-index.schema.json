{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "worker",
    "source_sha",
    "fixture_sha256",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "job-awareness-evidence-index-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^JA-[A-Za-z0-9_-]{8,60}$"
    },
    "worker": {
      "type": "string",
      "enum": [
        "W1",
        "W2",
        "W3",
        "W4",
        "W5"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "media_type",
          "provenance",
          "layer",
          "redacted",
          "privacy_checked",
          "event_ids"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "enum": [
              "fixture_generated",
              "server_generated",
              "server_sent",
              "client_received",
              "model_used",
              "workflow_continued"
            ]
          },
          "redacted": {
            "type": "boolean"
          },
          "privacy_checked": {
            "type": "boolean"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
