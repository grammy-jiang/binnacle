{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "source_sha",
    "docs_sha",
    "recorded_at",
    "tools",
    "runtime",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "job-awareness-s0-provenance-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^JA-[A-Za-z0-9_-]{8,60}$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "docs_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "tools": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "verified"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "runtime": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
