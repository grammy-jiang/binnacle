{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "worker",
    "scenario_id",
    "kind",
    "input_refs",
    "event_ids",
    "records",
    "blocker",
    "details"
  ],
  "properties": {
    "schema": {
      "const": "job-awareness-trace-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^JA-[A-Za-z0-9_-]{8,60}$"
    },
    "worker": {
      "enum": [
        "W1",
        "W2",
        "W3",
        "W4",
        "W5"
      ]
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "wire",
        "identity",
        "receipt",
        "performance",
        "ui",
        "control"
      ]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "event_id",
          "layer",
          "direction",
          "request_sha256",
          "response_sha256",
          "expected",
          "observed",
          "supported"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "fixture_generated",
              "server_generated",
              "server_sent",
              "client_received",
              "model_used",
              "workflow_continued"
            ]
          },
          "direction": {
            "enum": [
              "input",
              "output",
              "state_change",
              "observation"
            ]
          },
          "request_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "response_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "supported": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object"
    }
  }
}
