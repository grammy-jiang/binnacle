{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "worker",
    "source_sha",
    "docs_sha",
    "fixture_sha256",
    "fixture_path",
    "issued_at",
    "model_request",
    "subject_request",
    "worktree_path",
    "results_path",
    "scenarios",
    "inputs",
    "outputs",
    "limits",
    "permissions"
  ],
  "properties": {
    "schema": {
      "const": "job-awareness-worker-input-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^JA-[A-Za-z0-9_-]{8,60}$"
    },
    "worker": {
      "type": "string",
      "enum": [
        "W1",
        "W2",
        "W3",
        "W4",
        "W5"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "docs_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_path": {
      "const": "fixtures/fixture-manifest.json"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject_request": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "model",
            "effort"
          ],
          "properties": {
            "surface": {
              "const": "ChatGPT Chat"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "worktree_path": {
      "type": "string",
      "minLength": 1
    },
    "results_path": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "format",
          "sha256",
          "purpose"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "jsonl",
              "csv",
              "md",
              "py",
              "txt",
              "wire-json",
              "app"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "format",
          "purpose"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "jsonl",
              "csv",
              "md"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runtime_s",
        "max_spend_usd",
        "memory_safety_margin_mb"
      ],
      "properties": {
        "max_runtime_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_spend_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "memory_safety_margin_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "permissions": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gui",
        "production_writes",
        "other_worker_writes"
      ],
      "properties": {
        "gui": {
          "type": "boolean"
        },
        "production_writes": {
          "const": false
        },
        "other_worker_writes": {
          "const": false
        }
      }
    }
  }
}
