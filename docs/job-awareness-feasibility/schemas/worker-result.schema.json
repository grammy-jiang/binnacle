{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "worker",
    "source_sha",
    "docs_sha",
    "fixture_sha256",
    "input_sha256",
    "started_at",
    "finished_at",
    "state",
    "executor",
    "subject",
    "scenarios",
    "metrics",
    "limitations",
    "artifact_index",
    "hypotheses"
  ],
  "properties": {
    "schema": {
      "const": "job-awareness-worker-result-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^JA-[A-Za-z0-9_-]{8,60}$"
    },
    "worker": {
      "type": "string",
      "enum": [
        "W1",
        "W2",
        "W3",
        "W4",
        "W5"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "docs_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "executor": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "version",
        "session_ref",
        "model"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "session_ref": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested_model",
            "requested_effort",
            "effective_model",
            "effective_effort",
            "verification",
            "verification_evidence_ref",
            "fallback_used",
            "model_match_verified",
            "effort_match_verified"
          ],
          "properties": {
            "requested_model": {
              "type": "string",
              "minLength": 1
            },
            "requested_effort": {
              "type": "string",
              "minLength": 1
            },
            "effective_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "effective_effort": {
              "type": [
                "string",
                "null"
              ]
            },
            "verification": {
              "type": "string",
              "enum": [
                "VERIFIED",
                "UNVERIFIED",
                "UNAVAILABLE"
              ]
            },
            "verification_evidence_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "fallback_used": {
              "type": "boolean"
            },
            "model_match_verified": {
              "type": "boolean"
            },
            "effort_match_verified": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "subject": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "model"
          ],
          "properties": {
            "surface": {
              "const": "ChatGPT Chat"
            },
            "model": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requested_model",
                "requested_effort",
                "effective_model",
                "effective_effort",
                "verification",
                "verification_evidence_ref",
                "fallback_used",
                "model_match_verified",
                "effort_match_verified"
              ],
              "properties": {
                "requested_model": {
                  "type": "string",
                  "minLength": 1
                },
                "requested_effort": {
                  "type": "string",
                  "minLength": 1
                },
                "effective_model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "effective_effort": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verification": {
                  "type": "string",
                  "enum": [
                    "VERIFIED",
                    "UNVERIFIED",
                    "UNAVAILABLE"
                  ]
                },
                "verification_evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fallback_used": {
                  "type": "boolean"
                },
                "model_match_verified": {
                  "type": "boolean"
                },
                "effort_match_verified": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "expected",
          "observed",
          "input_refs",
          "evidence_refs",
          "event_ids",
          "proof_layers",
          "duration_ms",
          "blocking_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proof_layers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "fixture_generated",
                "server_generated",
                "server_sent",
                "client_received",
                "model_used",
                "workflow_continued"
              ]
            }
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "blocking_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_index": {
      "const": "evidence-index.json"
    },
    "hypotheses": {
      "type": "object",
      "patternProperties": {
        "^H[1-6]$": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "REFUTED",
            "UNRESOLVED"
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  }
}
