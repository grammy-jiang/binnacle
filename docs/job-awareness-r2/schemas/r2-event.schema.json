{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "job-awareness-r2-event-v1"
    },
    "r2_run_id": {
      "type": "string",
      "pattern": "^R2-[A-Za-z0-9_-]{8,70}$"
    },
    "lane": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E0",
        "E1",
        "E2"
      ]
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "proof_layer": {
      "type": "string",
      "enum": [
        "synthetic_generated",
        "server_serialized",
        "server_sent",
        "client_received",
        "model_used",
        "workflow_continued"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "synthetic_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "synthetic_chat_alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "r2_run_id",
    "lane",
    "scenario_id",
    "event_id",
    "observed_at",
    "proof_layer",
    "source_ref",
    "input_sha256",
    "result_sha256",
    "synthetic_job_id",
    "synthetic_chat_alias",
    "observation"
  ]
}
