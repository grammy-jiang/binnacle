{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "job-awareness-r2-run-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^R2-[A-Za-z0-9_-]{8,70}$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "r1_docs_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "r2_docs_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "r1_fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "r2_fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "r1_run_id": {
      "const": "JA-20261010-174301-ead99b0c"
    },
    "r2_fixtures_path": {
      "const": "fixtures/fixture-manifest.json"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "FROZEN",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "worker_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "A": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "B": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "C": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "D": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "E0": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "A",
        "B",
        "C",
        "D",
        "E0"
      ]
    },
    "chat_connection_state": {
      "enum": [
        "UNVERIFIED",
        "READY",
        "BLOCKED"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "run_id",
    "source_sha",
    "r1_docs_sha",
    "r2_docs_sha",
    "r1_fixture_sha256",
    "r2_fixture_sha256",
    "r1_run_id",
    "r2_fixtures_path",
    "frozen_at",
    "state",
    "worker_inputs",
    "chat_connection_state",
    "notes"
  ]
}
