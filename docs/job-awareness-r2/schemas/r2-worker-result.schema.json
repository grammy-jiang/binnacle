{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "job-awareness-r2-result-v1"
    },
    "r2_run_id": {
      "type": "string",
      "pattern": "^R2-[A-Za-z0-9_-]{8,70}$"
    },
    "lane": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E0",
        "E1",
        "E2"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "r1_docs_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "r2_docs_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "r1_fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "r2_fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "session_ref": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requested_model": {
              "type": "string",
              "minLength": 1
            },
            "requested_effort": {
              "type": "string",
              "minLength": 1
            },
            "effective_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "effective_effort": {
              "type": [
                "string",
                "null"
              ]
            },
            "verification": {
              "enum": [
                "VERIFIED",
                "UNVERIFIED",
                "UNAVAILABLE"
              ]
            },
            "proof_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "fallback_used": {
              "const": false
            },
            "session_ref": {
              "type": "string",
              "minLength": 1
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "requested_model",
            "requested_effort",
            "effective_model",
            "effective_effort",
            "verification",
            "proof_ref",
            "fallback_used",
            "session_ref",
            "observed_at"
          ]
        }
      },
      "required": [
        "surface",
        "version",
        "session_ref",
        "model"
      ]
    },
    "subject": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "const": "ChatGPT Chat"
            },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requested_model": {
                  "type": "string",
                  "minLength": 1
                },
                "requested_effort": {
                  "type": "string",
                  "minLength": 1
                },
                "effective_model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "effective_effort": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verification": {
                  "enum": [
                    "VERIFIED",
                    "UNVERIFIED",
                    "UNAVAILABLE"
                  ]
                },
                "proof_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "fallback_used": {
                  "const": false
                },
                "session_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "requested_model",
                "requested_effort",
                "effective_model",
                "effective_effort",
                "verification",
                "proof_ref",
                "fallback_used",
                "session_ref",
                "observed_at"
              ]
            }
          },
          "required": [
            "surface",
            "model"
          ]
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "hypotheses": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "SUPPORTED",
          "REFUTED",
          "UNRESOLVED"
        ]
      },
      "minProperties": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proof_layers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "synthetic_generated",
                "server_serialized",
                "server_sent",
                "client_received",
                "model_used",
                "workflow_continued"
              ]
            }
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "blocking_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "state",
          "expected",
          "observed",
          "input_refs",
          "evidence_refs",
          "event_ids",
          "proof_layers",
          "duration_ms",
          "blocking_reason"
        ]
      }
    },
    "metrics": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_index": {
      "const": "evidence-index.json"
    }
  },
  "required": [
    "schema",
    "r2_run_id",
    "lane",
    "source_sha",
    "r1_docs_sha",
    "r2_docs_sha",
    "r1_fixture_sha256",
    "r2_fixture_sha256",
    "input_packet_sha256",
    "started_at",
    "finished_at",
    "executor",
    "subject",
    "state",
    "hypotheses",
    "scenarios",
    "metrics",
    "limitations",
    "artifact_index"
  ]
}
