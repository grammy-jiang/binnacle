{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binnacle.dev/schemas/acceptance/phase10-run.schema.json",
  "title": "Binnacle Phase 10 self-hosting acceptance run v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "acceptance_run_id": {
      "$ref": "#/$defs/identifier"
    },
    "plan_version": {
      "const": "phase10-self-hosting-acceptance-v1"
    },
    "policy_sha256": {
      "$ref": "#/$defs/digest"
    },
    "state": {
      "$ref": "#/$defs/runState"
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "baseline": {
      "oneOf": [
        {
          "$ref": "#/$defs/baseline"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "oneOf": [
        {
          "$ref": "#/$defs/branch"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_generations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/candidateGeneration"
      }
    },
    "final_candidate_generation": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "integration_generations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/integrationGeneration"
      }
    },
    "final_integration_generation": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_exercise": {
      "oneOf": [
        {
          "$ref": "#/$defs/failureExercise"
        },
        {
          "type": "null"
        }
      ]
    },
    "github_pr": {
      "oneOf": [
        {
          "$ref": "#/$defs/githubPullRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "github_merge": {
      "oneOf": [
        {
          "$ref": "#/$defs/githubMerge"
        },
        {
          "type": "null"
        }
      ]
    },
    "local_update": {
      "oneOf": [
        {
          "$ref": "#/$defs/localUpdate"
        },
        {
          "type": "null"
        }
      ]
    },
    "post_merge_local_checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/postMergeCheck"
      }
    },
    "restart": {
      "oneOf": [
        {
          "$ref": "#/$defs/restart"
        },
        {
          "type": "null"
        }
      ]
    },
    "post_restart_runtime": {
      "oneOf": [
        {
          "$ref": "#/$defs/postRestartRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "behaviour_probe": {
      "oneOf": [
        {
          "$ref": "#/$defs/behaviourProbe"
        },
        {
          "type": "null"
        }
      ]
    },
    "security_checks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/securityCheck"
      }
    },
    "unresolved_refs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "owner_review": {
      "oneOf": [
        {
          "$ref": "#/$defs/ownerReview"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "acceptance_run_id",
    "plan_version",
    "policy_sha256",
    "state",
    "readiness",
    "baseline",
    "branch",
    "candidate_generations",
    "final_candidate_generation",
    "integration_generations",
    "final_integration_generation",
    "failure_exercise",
    "github_pr",
    "github_merge",
    "local_update",
    "post_merge_local_checks",
    "restart",
    "post_restart_runtime",
    "behaviour_probe",
    "security_checks",
    "unresolved_refs",
    "owner_review"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "gitRef": {
      "type": "string",
      "minLength": 12,
      "maxLength": 512,
      "pattern": "^refs/(heads|remotes)/[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "id",
        "sha256"
      ]
    },
    "nullableEvidenceRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidenceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "runState": {
      "enum": [
        "planned",
        "readiness_verifying",
        "baseline_ready",
        "branch_ready",
        "change_in_progress",
        "local_checks_in_progress",
        "local_checks_ready",
        "candidate_signed",
        "candidate_pushed",
        "hosted_review_in_progress",
        "candidate_superseded",
        "integration_verifying",
        "integration_stale",
        "hosted_merge_ready",
        "hosted_merged",
        "local_update_ready",
        "merged_checks_in_progress",
        "merged_checks_ready",
        "restart_preflight_ready",
        "restart_in_progress",
        "reconnecting",
        "runtime_verified",
        "behaviour_verified",
        "evidence_closing",
        "passed",
        "failed",
        "incomplete"
      ]
    },
    "verificationStatus": {
      "enum": [
        "verified",
        "unavailable",
        "stale",
        "failed"
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/nullableEvidenceRef"
        },
        "real_chatgpt_connection": {
          "$ref": "#/$defs/verificationStatus"
        },
        "real_development_pi": {
          "$ref": "#/$defs/verificationStatus"
        },
        "predecessor_promotions": {
          "$ref": "#/$defs/verificationStatus"
        },
        "baseline_coherence": {
          "$ref": "#/$defs/verificationStatus"
        }
      },
      "required": [
        "evidence_ref",
        "real_chatgpt_connection",
        "real_development_pi",
        "predecessor_promotions",
        "baseline_coherence"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "runtime_oid": {
          "$ref": "#/$defs/oid"
        },
        "runtime_tree_oid": {
          "$ref": "#/$defs/oid"
        },
        "runtime_instance_sha256": {
          "$ref": "#/$defs/digest"
        },
        "repository_head_oid": {
          "$ref": "#/$defs/oid"
        },
        "protected_base_oid": {
          "$ref": "#/$defs/oid"
        },
        "repository_clean": {
          "type": "boolean"
        },
        "controller_sha256": {
          "$ref": "#/$defs/digest"
        },
        "device_sha256": {
          "$ref": "#/$defs/digest"
        },
        "workspace_sha256": {
          "$ref": "#/$defs/digest"
        },
        "runtime_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "commit_signer_sha256": {
          "$ref": "#/$defs/digest"
        },
        "remote_profile_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "evidence_ref",
        "runtime_oid",
        "runtime_tree_oid",
        "runtime_instance_sha256",
        "repository_head_oid",
        "protected_base_oid",
        "repository_clean",
        "controller_sha256",
        "device_sha256",
        "workspace_sha256",
        "runtime_profile_sha256",
        "commit_signer_sha256",
        "remote_profile_sha256"
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "ref": {
          "$ref": "#/$defs/gitRef"
        },
        "created_from_oid": {
          "$ref": "#/$defs/oid"
        },
        "observed_oid": {
          "$ref": "#/$defs/oid"
        },
        "protected_branch_mutated": {
          "type": "boolean"
        }
      },
      "required": [
        "evidence_ref",
        "ref",
        "created_from_oid",
        "observed_oid",
        "protected_branch_mutated"
      ]
    },
    "checkConclusion": {
      "enum": [
        "success",
        "failure",
        "uncertain"
      ]
    },
    "localCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "$ref": "#/$defs/identifier"
        },
        "check_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "evidence_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "evidence_binding_sha256": {
          "$ref": "#/$defs/digest"
        },
        "source_content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "conclusion": {
          "$ref": "#/$defs/checkConclusion"
        },
        "terminal": {
          "type": "boolean"
        },
        "descendants_closed": {
          "type": "boolean"
        },
        "workspace_fence_closed": {
          "type": "boolean"
        }
      },
      "required": [
        "check_id",
        "check_profile_sha256",
        "evidence_ref",
        "evidence_binding_sha256",
        "source_content_sha256",
        "conclusion",
        "terminal",
        "descendants_closed",
        "workspace_fence_closed"
      ]
    },
    "statusDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "parent_oid": {
          "$ref": "#/$defs/oid"
        },
        "branch_ref": {
          "$ref": "#/$defs/gitRef"
        },
        "diff_sha256": {
          "$ref": "#/$defs/digest"
        },
        "repository_safety_sha256": {
          "$ref": "#/$defs/digest"
        },
        "unexpected_paths": {
          "type": "boolean"
        }
      },
      "required": [
        "evidence_ref",
        "parent_oid",
        "branch_ref",
        "diff_sha256",
        "repository_safety_sha256",
        "unexpected_paths"
      ]
    },
    "signedCommit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "oid": {
          "$ref": "#/$defs/oid"
        },
        "tree_oid": {
          "$ref": "#/$defs/oid"
        },
        "parent_oid": {
          "$ref": "#/$defs/oid"
        },
        "signer_sha256": {
          "$ref": "#/$defs/digest"
        },
        "signature_verified": {
          "type": "boolean"
        },
        "source_content_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "evidence_ref",
        "oid",
        "tree_oid",
        "parent_oid",
        "signer_sha256",
        "signature_verified",
        "source_content_sha256"
      ]
    },
    "push": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "target_oid": {
          "$ref": "#/$defs/oid"
        },
        "remote_observed_oid": {
          "$ref": "#/$defs/oid"
        },
        "remote_ref": {
          "$ref": "#/$defs/gitRef"
        },
        "remote_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "conclusion": {
          "$ref": "#/$defs/checkConclusion"
        }
      },
      "required": [
        "evidence_ref",
        "target_oid",
        "remote_observed_oid",
        "remote_ref",
        "remote_profile_sha256",
        "conclusion"
      ]
    },
    "candidateGeneration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "source_content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "change_scope_sha256": {
          "$ref": "#/$defs/digest"
        },
        "local_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/localCheck"
          }
        },
        "status_diff": {
          "$ref": "#/$defs/statusDiff"
        },
        "signed_commit": {
          "$ref": "#/$defs/signedCommit"
        },
        "push": {
          "$ref": "#/$defs/push"
        },
        "hosted_head_oid": {
          "$ref": "#/$defs/oid"
        },
        "superseded_reason_ref": {
          "$ref": "#/$defs/nullableEvidenceRef"
        }
      },
      "required": [
        "generation",
        "source_content_sha256",
        "change_scope_sha256",
        "local_checks",
        "status_diff",
        "signed_commit",
        "push",
        "hosted_head_oid",
        "superseded_reason_ref"
      ]
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "$ref": "#/$defs/evidenceRef"
        },
        "candidate_oid": {
          "$ref": "#/$defs/oid"
        },
        "protected_base_oid": {
          "$ref": "#/$defs/oid"
        },
        "substantive": {
          "type": "boolean"
        },
        "clean": {
          "type": "boolean"
        },
        "unresolved_actionable_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "evidence_ref",
        "candidate_oid",
        "protected_base_oid",
        "substantive",
        "clean",
        "unresolved_actionable_count"
      ]
    },
    "ciCheckoutAttestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "event_name": {
          "enum": [
            "pull_request",
            "push"
          ]
        },
        "workflow_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "job_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "collector_commit_oid": {
          "$ref": "#/$defs/oid"
        },
        "collector_sha256": {
          "$ref": "#/$defs/digest"
        },
        "event_candidate_oid": {
          "oneOf": [
            {
              "$ref": "#/$defs/oid"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_base_oid": {
          "oneOf": [
            {
              "$ref": "#/$defs/oid"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_after_oid": {
          "oneOf": [
            {
              "$ref": "#/$defs/oid"
            },
            {
              "type": "null"
            }
          ]
        },
        "github_sha": {
          "$ref": "#/$defs/oid"
        },
        "checkout_oid": {
          "$ref": "#/$defs/oid"
        },
        "checkout_tree_oid": {
          "$ref": "#/$defs/oid"
        },
        "checkout_parent_oids": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/oid"
          }
        },
        "checkout_kind": {
          "enum": [
            "pull_request_integration",
            "push_commit",
            "unbound"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "repository",
        "event_name",
        "workflow_name",
        "job_name",
        "run_id",
        "run_attempt",
        "collector_commit_oid",
        "collector_sha256",
        "event_candidate_oid",
        "event_base_oid",
        "event_after_oid",
        "github_sha",
        "checkout_oid",
        "checkout_tree_oid",
        "checkout_parent_oids",
        "checkout_kind",
        "created_at"
      ]
    },
    "githubArtifactApiObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "size_in_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49152
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "archive_download_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expired": {
          "type": "boolean"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workflow_run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "head_sha": {
              "$ref": "#/$defs/oid"
            }
          },
          "required": [
            "id",
            "head_sha"
          ]
        }
      },
      "required": [
        "repository",
        "id",
        "name",
        "size_in_bytes",
        "url",
        "archive_download_url",
        "expired",
        "digest",
        "workflow_run"
      ]
    },
    "githubCiApiObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "run_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "workflow_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "head_sha": {
              "$ref": "#/$defs/oid"
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z_]+$"
            },
            "conclusion": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[a-z_]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "check_run_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "id",
            "run_id",
            "run_attempt",
            "workflow_name",
            "name",
            "head_sha",
            "status",
            "conclusion",
            "url",
            "check_run_url"
          ]
        },
        "workflow_run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "workflow_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\.github/workflows/[A-Za-z0-9][A-Za-z0-9_.-]*\\.ya?ml$"
            },
            "event": {
              "const": "pull_request"
            },
            "head_sha": {
              "$ref": "#/$defs/oid"
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z_]+$"
            },
            "conclusion": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[a-z_]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "jobs_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "id",
            "run_attempt",
            "workflow_id",
