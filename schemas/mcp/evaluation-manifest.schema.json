{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binnacle.dev/schemas/mcp/evaluation-manifest.schema.json",
  "title": "Binnacle ChatGPT MCP evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "evaluation_profile_id": { "$ref": "#/$defs/identifier" },
    "evaluation_profile_version": { "$ref": "#/$defs/version" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "tester": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tester_id": { "$ref": "#/$defs/identifier" },
        "owner_is_tester": { "type": "boolean" },
        "reviewer_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "required": ["tester_id", "owner_is_tester", "reviewer_ids"]
    },
    "chatgpt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": { "type": "string", "minLength": 1, "maxLength": 128 },
        "surface": { "type": "string", "minLength": 1, "maxLength": 128 },
        "plan": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workspace_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "account_reference_digest": { "$ref": "#/$defs/sha256" },
        "workspace_policy_digest": { "$ref": "#/$defs/sha256" },
        "host_release_evidence": { "type": ["string", "null"], "maxLength": 512 },
        "client_application": { "type": ["string", "null"], "maxLength": 256 },
        "client_version": { "type": ["string", "null"], "maxLength": 128 },
        "region": { "type": ["string", "null"], "maxLength": 128 }
      },
      "required": [
        "product",
        "surface",
        "plan",
        "workspace_type",
        "account_reference_digest",
        "workspace_policy_digest",
        "host_release_evidence",
        "client_application",
        "client_version",
        "region"
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "$ref": "#/$defs/identifier" },
        "endpoint_digest": { "$ref": "#/$defs/sha256" },
        "authentication_profile": { "$ref": "#/$defs/identifier" },
        "controller_profile_version": { "$ref": "#/$defs/version" },
        "tunnel_or_gateway_release_digest": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "configuration_digest": { "$ref": "#/$defs/sha256" }
      },
      "required": [
        "method",
        "endpoint_digest",
        "authentication_profile",
        "controller_profile_version",
        "tunnel_or_gateway_release_digest",
        "configuration_digest"
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_id": { "$ref": "#/$defs/identifier" },
        "release_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "mcp_sdk_version": { "$ref": "#/$defs/version" },
        "mcp_sdk_sha256": { "$ref": "#/$defs/sha256" },
        "tool_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "visible_catalogue_sha256": { "$ref": "#/$defs/sha256" },
        "schema_registry_sha256": { "$ref": "#/$defs/sha256" },
        "operation_contract_registry_sha256": { "$ref": "#/$defs/sha256" },
        "revision_dispatch_version": { "$ref": "#/$defs/version" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "device_profile_id": { "$ref": "#/$defs/identifier" },
        "device_profile_version": { "$ref": "#/$defs/version" },
        "os": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kernel": { "type": "string", "minLength": 1, "maxLength": 256 },
        "architecture": { "$ref": "#/$defs/identifier" }
      },
      "required": [
        "release_id",
        "release_manifest_sha256",
        "artifact_sha256",
        "source_commit",
        "mcp_sdk_version",
        "mcp_sdk_sha256",
        "tool_manifest_sha256",
        "visible_catalogue_sha256",
        "schema_registry_sha256",
        "operation_contract_registry_sha256",
        "revision_dispatch_version",
        "configuration_sha256",
        "device_profile_id",
        "device_profile_version",
        "os",
        "kernel",
        "architecture"
      ]
    },
    "test_definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_spec_sha256": { "$ref": "#/$defs/sha256" },
        "case_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "oracle_version": { "$ref": "#/$defs/version" },
        "selected_phases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "known_limitations": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      },
      "required": ["profile_spec_sha256", "case_manifest_sha256", "oracle_version", "selected_phases", "known_limitations"]
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/caseResult" }
    },
    "capability_conclusions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/capabilityConclusion" }
    },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/evidenceFile" }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": { "$ref": "#/$defs/identifier" },
        "policy_version": { "$ref": "#/$defs/version" },
        "applied_before_bundle_finalization": { "const": true },
        "categories_removed": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "full_conversation_collected": { "const": false }
      },
      "required": ["policy_id", "policy_version", "applied_before_bundle_finalization", "categories_removed", "full_conversation_collected"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["draft", "accepted", "rejected", "superseded"] },
        "reviewer_id": { "$ref": "#/$defs/identifier" },
        "reviewed_at": { "$ref": "#/$defs/timestamp" },
        "owner_decision": { "enum": ["accept", "reject", "narrow_profile", "rerun_required"] },
        "review_notes_digest": { "$ref": "#/$defs/sha256" }
      },
      "required": ["status", "reviewer_id", "reviewed_at", "owner_decision", "review_notes_digest"]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "rerun_trigger_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "required": ["valid_from", "valid_until", "rerun_trigger_ids"]
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_sha256": { "$ref": "#/$defs/sha256" },
        "signature_or_attestation_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "external_receipt_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      },
      "required": ["file_manifest_sha256", "bundle_sha256", "signature_or_attestation_sha256", "external_receipt_sha256"]
    }
  },
  "required": [
    "schema_version",
    "evaluation_profile_id",
    "evaluation_profile_version",
    "run_id",
    "started_at",
    "ended_at",
    "tester",
    "chatgpt",
    "connection",
    "probe",
    "test_definition",
    "case_results",
    "capability_conclusions",
    "evidence_files",
    "redaction",
    "review",
    "validity",
    "bundle"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "phase": { "$ref": "#/$defs/identifier" },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["passed", "failed", "blocked", "inconclusive", "not_applicable"] },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "oracle_version": { "$ref": "#/$defs/version" },
        "expected_digest": { "$ref": "#/$defs/sha256" },
        "observed_digest": { "$ref": "#/$defs/sha256" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "prohibited_effect_count": { "type": "integer", "minimum": 0 },
        "adjudication": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "required": [
        "case_id",
        "phase",
        "attempt",
        "status",
        "started_at",
        "ended_at",
        "oracle_version",
        "expected_digest",
        "observed_digest",
        "evidence_refs",
        "prohibited_effect_count",
        "adjudication"
      ]
    },
    "capabilityConclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis": { "$ref": "#/$defs/identifier" },
        "status": {
          "enum": [
            "supported_observed",
            "declared_unexercised",
            "failed",
            "unstable",
            "not_declared",
            "blocked_by_host_policy",
            "not_implemented_by_probe",
            "not_applicable",
            "expired"
          ]
        },
        "required_case_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "passed_case_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "failed_or_blocked_case_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "selected_by_interface": { "type": "boolean" }
      },
      "required": [
        "axis",
        "status",
        "required_case_ids",
        "passed_case_ids",
        "failed_or_blocked_case_ids",
        "summary",
        "selected_by_interface"
      ]
    },
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "information_class": { "enum": ["normal-result", "restricted-result"] },
        "redacted": { "type": "boolean" },
        "source": { "enum": ["server", "host-ui", "tester", "network", "generated-summary", "external"] }
      },
      "required": ["evidence_id", "path", "media_type", "sha256", "size_bytes", "information_class", "redacted", "source"]
    }
  }
}
