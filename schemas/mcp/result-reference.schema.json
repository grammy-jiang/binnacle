{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binnacle.dev/schemas/mcp/result-reference.schema.json",
  "title": "Binnacle retained result, pagination, and chunk schemas",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "opaqueReference": {
      "type": "string",
      "minLength": 24,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "informationClass": {
      "enum": ["normal-result", "restricted-result"]
    },
    "provenanceClass": {
      "enum": [
        "server-fact",
        "owner-configured",
        "local-untrusted",
        "external-untrusted",
        "protected-owner-data",
        "model-supplied-unknown",
        "derived"
      ]
    },
    "resultLifecycle": {
      "enum": ["building", "complete", "failed", "expired", "deleted"]
    },
    "retentionClass": {
      "enum": ["RR1-transient", "RR2-operation", "RR3-audit-or-support", "RR4-uncertain"]
    },
    "resultReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_ref": { "$ref": "#/$defs/opaqueReference" },
        "result_id": { "$ref": "#/$defs/identifier" },
        "lifecycle": { "$ref": "#/$defs/resultLifecycle" },
        "delivery_mode": { "enum": ["item-page", "byte-chunk"] },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "encoding": { "enum": ["utf-8", "base64", "json-items", "binary-records"] },
        "information_class": { "$ref": "#/$defs/informationClass" },
        "provenance": { "$ref": "#/$defs/provenanceClass" },
        "item_count": { "type": ["integer", "null"], "minimum": 0 },
        "decoded_byte_count": { "type": ["integer", "null"], "minimum": 0 },
        "full_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "retention_class": { "$ref": "#/$defs/retentionClass" },
        "producing_operation_id": {
          "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "tool_name": { "$ref": "#/$defs/identifier" },
        "tool_contract_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "snapshot_id": {
          "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "query_fingerprint": { "$ref": "#/$defs/sha256" },
        "complete": { "type": "boolean" }
      },
      "required": [
        "result_ref",
        "result_id",
        "lifecycle",
        "delivery_mode",
        "media_type",
        "encoding",
        "information_class",
        "provenance",
        "item_count",
        "decoded_byte_count",
        "full_sha256",
        "created_at",
        "completed_at",
        "expires_at",
        "retention_class",
        "producing_operation_id",
        "tool_name",
        "tool_contract_version",
        "snapshot_id",
        "query_fingerprint",
        "complete"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "lifecycle": { "const": "complete" } },
            "required": ["lifecycle"]
          },
          "then": {
            "properties": {
              "complete": { "const": true },
              "completed_at": { "$ref": "#/$defs/timestamp" },
              "full_sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "else": {
            "properties": { "complete": { "const": false } }
          }
        }
      ]
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "truncated": { "type": "boolean" },
        "returned_items": { "type": ["integer", "null"], "minimum": 0 },
        "returned_decoded_bytes": { "type": "integer", "minimum": 0 },
        "total_known": { "type": "boolean" },
        "total_items": { "type": ["integer", "null"], "minimum": 0 },
        "total_decoded_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "omitted_known": { "type": "boolean" },
        "continuation_available": { "type": "boolean" },
        "transformation": { "type": ["string", "null"], "maxLength": 128 }
      },
      "required": [
        "truncated",
        "returned_items",
        "returned_decoded_bytes",
        "total_known",
        "total_items",
        "total_decoded_bytes",
        "omitted_known",
        "continuation_available",
        "transformation"
      ]
    },
    "pageCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": { "$ref": "#/$defs/opaqueReference" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "snapshot_id": { "$ref": "#/$defs/identifier" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 500 }
      },
      "required": ["cursor", "expires_at", "snapshot_id", "page_size"]
    },
    "result_get.input.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_ref": { "$ref": "#/$defs/opaqueReference" }
      },
      "required": ["result_ref"]
    },
    "result_get.output.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": { "$ref": "#/$defs/resultReference" },
        "status_guidance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 },
            "operation_id": {
              "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
            },
            "next_action": {
              "enum": ["read_page", "read_chunk", "poll_result", "query_operation", "none"]
            }
          },
          "required": ["retry_after_ms", "operation_id", "next_action"]
        }
      },
      "required": ["result", "status_guidance"]
    },
    "result_page.input.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_ref": { "$ref": "#/$defs/opaqueReference" },
        "cursor": {
          "anyOf": [{ "$ref": "#/$defs/opaqueReference" }, { "type": "null" }]
        },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 500 }
      },
      "required": ["result_ref", "cursor", "page_size"]
    },
    "result_page.output.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": { "$ref": "#/$defs/resultReference" },
        "snapshot_id": { "$ref": "#/$defs/identifier" },
        "consistency": { "enum": ["immutable_snapshot", "live_unstable"] },
        "page_index": { "type": "integer", "minimum": 0 },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": { "$ref": "#/$defs/identifier" },
              "ordinal": { "type": "integer", "minimum": 0 },
              "data": {}
            },
            "required": ["item_id", "ordinal", "data"]
          }
        },
        "next_cursor": {
          "anyOf": [{ "$ref": "#/$defs/pageCursor" }, { "type": "null" }]
        },
        "end_of_results": { "type": "boolean" },
        "cumulative_items_returned": { "type": "integer", "minimum": 0 },
        "page_sha256": { "$ref": "#/$defs/sha256" },
        "truncation": { "$ref": "#/$defs/truncation" },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      },
      "required": [
        "result",
        "snapshot_id",
        "consistency",
        "page_index",
        "items",
        "next_cursor",
        "end_of_results",
        "cumulative_items_returned",
        "page_sha256",
        "truncation",
        "warnings"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "end_of_results": { "const": true } },
            "required": ["end_of_results"]
          },
          "then": { "properties": { "next_cursor": { "type": "null" } } },
          "else": { "properties": { "next_cursor": { "$ref": "#/$defs/pageCursor" } } }
        }
      ]
    },
    "result_chunk.input.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_ref": { "$ref": "#/$defs/opaqueReference" },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "encoding": { "enum": ["utf-8", "base64"] }
      },
      "required": ["result_ref", "offset", "length", "encoding"]
    },
    "result_chunk.output.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": { "$ref": "#/$defs/resultReference" },
        "requested_offset": { "type": "integer", "minimum": 0 },
        "requested_length": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "returned_offset": { "type": "integer", "minimum": 0 },
        "returned_decoded_length": { "type": "integer", "minimum": 0, "maximum": 262144 },
        "range_adjusted_for_encoding": { "type": "boolean" },
        "encoding": { "enum": ["utf-8", "base64"] },
        "content": { "type": "string", "maxLength": 349528 },
        "chunk_sha256": { "$ref": "#/$defs/sha256" },
        "next_offset": { "type": ["integer", "null"], "minimum": 0 },
        "end_of_result": { "type": "boolean" },
        "truncation": { "$ref": "#/$defs/truncation" }
      },
      "required": [
        "result",
        "requested_offset",
        "requested_length",
        "returned_offset",
        "returned_decoded_length",
        "range_adjusted_for_encoding",
        "encoding",
        "content",
        "chunk_sha256",
        "next_offset",
        "end_of_result",
        "truncation"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "end_of_result": { "const": true } },
            "required": ["end_of_result"]
          },
          "then": { "properties": { "next_offset": { "type": "null" } } },
          "else": { "properties": { "next_offset": { "type": "integer", "minimum": 0 } } }
        }
      ]
    }
  }
}
