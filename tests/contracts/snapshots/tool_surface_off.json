   "description": "Status of a job from run_command, or the recent-jobs list when\njob_id is omitted. Only needed when run_command returned a job_id.\nA positive wait blocks up to the requested duration (max 50 seconds)\nor any smaller effective turn budget; waiting never kills a still-running\njob. Returns state, exit code, output tail, and live processes;\nquiet=true means no recent output.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "job_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Job to check. Omit to list recent jobs."
     },
     "tail_lines": {
      "default": 100,
      "description": "Lines of merged output to tail.",
      "minimum": 1,
      "type": "integer"
     },
     "wait_seconds": {
      "default": 0,
      "description": "Block up to this long (max 50) for the job to exit before answering; 0 answers at once.",
      "maximum": 50,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
