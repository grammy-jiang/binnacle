   "description": "Read a text file, optionally a line range (1-based, inclusive). One call returns at most 24k chars (about 6k tokens, ~480 lines of prose); a file within that comes back whole, so omit the range. For a larger file do not page through it: search_text to locate, then read only that range. Returns plain content without line numbers, plus total_lines and next_start_line when truncated. Binary or media files return a note; inspect those with run_command (file, xxd, pdftotext).",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "end_line": {
      "anyOf": [
       {
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "1-based last line, inclusive. Values past the end of the file are clamped."
     },
     "path": {
      "description": "Absolute path (~ allowed). A relative path resolves against ~/Projects.",
      "type": "string"
     },
     "start_line": {
      "default": 1,
      "description": "1-based first line to read.",
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "path"
    ],
    "type": "object"
   },
