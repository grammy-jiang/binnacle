   "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
    "title": null
   },
   "description": "Replace an exact string in a text file. old_string must match\nthe file byte-for-byte (copy it from read_file content; never\ninclude line-number prefixes) and must be unique unless\nreplace_all=true. A whitespace-normalized fallback match is\nattempted and reported. Returns a snippet of the changed region.\nUse write_file to create files.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "new_string": {
      "description": "Replacement text; empty string deletes old_string.",
      "type": "string"
     },
     "old_string": {
      "description": "Exact text to replace, copied verbatim from the file.",
      "type": "string"
     },
     "path": {
      "description": "Absolute path (~ ok); relative resolves against ~/Projects.",
      "type": "string"
     },
     "replace_all": {
      "default": false,
      "description": "Replace every occurrence instead of requiring uniqueness.",
      "type": "boolean"
     }
    },
    "required": [
     "path",
     "old_string",
     "new_string"
    ],
    "type": "object"
   },
   "name": "edit_file",
   "outputSchema": {
    "properties": {
     "bytes": {
      "type": "integer"
     },
     "first_change_line": {
      "type": "integer"
     },
     "match": {
      "enum": [
       "exact",
       "whitespace_normalized"
      ],
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "replacements": {
      "type": "integer"
     },
     "snippet": {
      "type": "string"
     },
     "snippet_first_line": {
      "type": "integer"
     }
    },
    "required": [
     "path",
     "replacements",
     "match"
    ],
    "type": "object"
   }
