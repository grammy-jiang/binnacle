   "description": "Search repository content. Normal regex search replaces grep -rn;\nnames_only replaces grep -c; line_numbers supplies grep -n style context.\nPrefer this over grep in run_command. When the implementation location is\nunknown, use ``@context <query>`` with ``path`` set to the Git worktree\nroot, then verify/narrow with exact search as needed.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "context_lines": {
      "anyOf": [
       {
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Context lines around each match. Omit for automatic context on few matches."
     },
     "fixed_strings": {
      "default": false,
      "description": "Treat pattern as literal text.",
      "type": "boolean"
     },
     "glob": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only search files matching this glob (e.g. *.py)."
     },
     "line_numbers": {
      "default": false,
      "description": "Prefix each context line with its line number (grep -n style).",
      "type": "boolean"
     },
     "max_results": {
      "default": 100,
      "description": "Cap on returned matches.",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "names_only": {
      "default": false,
      "description": "Return only files and their match counts.",
      "type": "boolean"
     },
     "path": {
      "default": "~/Projects",
      "description": "File or directory to search. Absolute (~ ok); relative resolves against ~/Projects.",
      "type": "string"
     },
     "pattern": {
      "description": "Regex (Rust syntax), or `@context <query>` for indexed repository discovery when path is the Git worktree root. Use fixed_strings for literal text.",
      "type": "string"
     }
    },
    "required": [
     "pattern"
    ],
    "type": "object"
   },
