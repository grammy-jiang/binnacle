   "description": "Run a shell command with bash -c; several commands can go in one\ncall (set -e; a && b). Waits up to wait_seconds; a command still\nrunning then is not killed: you get a job_id for job_status and\nstop_job. A command that finished created no job. Output merges\nstdout and stderr.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "background": {
      "default": false,
      "description": "Return at once with a job_id after a 1 s warm-up. Local policy may also auto-background matching commands.",
      "type": "boolean"
     },
     "command": {
      "description": "Shell command, run as bash -c.",
      "type": "string"
     },
     "stdin": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Text piped to the command's stdin."
     },
     "tail_lines": {
      "anyOf": [
       {
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Return only the last N lines of output (no need to pipe through tail)."
     },
     "wait_seconds": {
      "default": 30,
      "description": "Seconds to wait before yielding a job_id (max 50).",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
     },
     "workdir": {
      "default": "~/Projects",
      "description": "Working directory; absolute (~ ok) or relative to ~/Projects. Must be inside ~/Projects or /tmp.",
      "type": "string"
     }
    },
    "required": [
     "command"
    ],
    "type": "object"
   },
